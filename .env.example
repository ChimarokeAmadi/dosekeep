# Copy to .env.local for `npm run dev`, and set the same names in Vercel → Settings → Environment Variables.
# (`npm run dev:local` needs none of these: it starts its own database.)

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dosekeep

# Long random strings. Generate each with:  openssl rand -base64 48
SESSION_SECRET=
CRON_SECRET=

# Public address of the app, used in the links texted to patients
APP_URL=http://localhost:3000

# SMS: "log" records messages without sending (testing). "africastalking" sends real SMS.
SMS_PROVIDER=log
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Only for `npm run seed` (password for the sample clinic's accounts)
SEED_PASSWORD=
